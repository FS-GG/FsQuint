<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable><DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Remove="FSharp.Core" />
    <PackageReference Include="FSharp.Core" Version="10.1.302" />
    <PackageReference Include="FsQuint.Tooling" Version="0.1.0" />
    <Compile Include="Program.fs" />
    <None Include="*.qnt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
