<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable><DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile></PropertyGroup>
  <ItemGroup><PackageReference Include="FSharp.Core" Version="10.1.401" /><PackageReference Include="FsQuint" Version="0.1.0" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/PureReplay.fs" Link="PureReplay.fs" Condition="!Exists('PureReplay.fs')" />
    <Compile Include="PureReplay.fs" Condition="Exists('PureReplay.fs')" />
    <None Include="../Shared/PureReplay.fs" Link="PureReplay.fs" CopyToOutputDirectory="PreserveNewest" Condition="!Exists('PureReplay.fs')" />
  </ItemGroup>
  <ItemGroup><Compile Include="Program.fs"/><None Include="queue.itf.json" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
