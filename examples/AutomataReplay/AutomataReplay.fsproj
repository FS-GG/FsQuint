<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/PureReplay.fs" Link="PureReplay.fs" Condition="!Exists('PureReplay.fs')" />
    <Compile Include="PureReplay.fs" Condition="Exists('PureReplay.fs')" />
    <None Include="../Shared/PureReplay.fs" Link="PureReplay.fs" CopyToOutputDirectory="PreserveNewest" Condition="!Exists('PureReplay.fs')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Remove="FSharp.Core" />
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
    <PackageReference Include="ByzantineSystems.Automata.Core" Version="[0.5.0]" />
    <PackageReference Include="ByzantineSystems.Automata.Runtime" Version="[0.5.0]" />
    <PackageReference Include="FsQuint" Version="[0.1.1]" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Approval.fs" />
    <Compile Include="Conformance.fs" />
    <Compile Include="Resolver.fs" />
    <Compile Include="Turnstile.fs" />
    <Compile Include="Correction.fs" />
    <Compile Include="ProtocolStore.fs" />
    <Compile Include="Protocol.fs" />
    <Compile Include="Program.fs" />
    <None Include="fixtures/**;*.qnt;baseline.json;packages.lock.json;*.fs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
