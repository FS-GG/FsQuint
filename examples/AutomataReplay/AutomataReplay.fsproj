<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Remove="FSharp.Core" />
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
    <PackageReference Include="ByzantineSystems.Automata.Core" Version="[0.5.0]" />
    <PackageReference Include="FsQuint" Version="[0.1.1]" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Approval.fs" />
    <Compile Include="Conformance.fs" />
    <Compile Include="Program.fs" />
    <None Include="fixtures/**;*.qnt;baseline.json;Approval.fs;Conformance.fs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
