<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- Standalone copied consumers must resolve the same public-feed hash as this repository. -->
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Remove="FSharp.Core" />
    <PackageReference Include="FSharp.Core" Version="10.1.403" />
    <PackageReference Include="ByzantineSystems.Automata.Storage.Sqlite" Version="[0.5.0]" />
    <PackageReference Include="ByzantineSystems.Automata.Storage.Postgres" Version="[0.5.0]" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
